{
  "name": "solution25/listrak",
  "description": "Listrak - Shopware 6 Plugin",
  "type": "shopware-platform-plugin",
  "version": "1.1.0",
  "license": "MIT",
  "authors": [
    {
      "name": "solution25",
      "email": "info@solution25.com",
      "homepage": "https://solution25.com/"
    }
  ],
  "require": {
    "php": "^8.2",
    "shopware/core": "~6.7.0",
    "shopware/storefront": "~6.7.0",
    "nicolab/php-ftp-client": "^2.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.5",
    "squizlabs/php_codesniffer": "^3.7",
    "symfony/browser-kit": "^7.2",
    "symfony/css-selector": "^7.2"
  },
  "extra": {
    "shopware-plugin-class": "Listrak\\Listrak",
    "plugin-icon": "src/Resources/config/plugin.png",
    "label": {
      "de-DE": "Listrak Plugin",
      "en-GB": "Listrak Plugin"
    },
    "description": {
      "en-GB": "Connect Shopware with Listrak to synchronize customers, orders and products, manage newsletter subscriptions, track consented storefront activity and send transactional emails.",
      "de-DE": "Verbinden Sie Shopware mit Listrak: Synchronisieren Sie Kunden, Bestellungen und Produkte, verwalten Sie Newsletter und senden Sie transaktionale E-Mails mit dem Flow Builder."
    },
    "manufacturerLink": {
      "de-DE": "https://solution25.com/",
      "en-GB": "https://solution25.com/en/home_en/"
    },
    "supportLink": {
      "de-DE": "https://solution25.com/",
      "en-GB": "https://solution25.com/en/home_en/"
    }
  },
  "autoload": {
    "psr-4": {
      "Listrak\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Listrak\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit --configuration phpunit.xml",
    "test:integration": "phpunit --configuration phpunit.integration.xml",
    "post-install-cmd": [
      "@enable-precommit"
    ],
    "post-update-cmd": [
      "@enable-precommit"
    ],
    "enable-precommit": [
      "cp ./pre-commit .git/hooks/pre-commit",
      "chmod +x .git/hooks/pre-commit"
    ]
  }
}
