{% sw_extends '@Storefront/storefront/base.html.twig' %}

{% block base_body_script %}
    {{ parent() }}
    {% block listrak_script %}
        {% if config('Listrak.config.merchantId') and config('Listrak.config.enableListrakTracking') %}
            {% set listrakTrackingOptions = {
                merchantId: config('Listrak.config.merchantId'),
                requiresCookieConsent: config('Listrak.config.enableListrakTrackingUponCookieAcceptance'),
                email: context.customer.email|default(''),
                productNumber: listrakProductNumber|default('')
            } %}
            <template data-listrak-tracking
                      data-listrak-tracking-options="{{ listrakTrackingOptions|json_encode|escape('html_attr') }}"></template>
        {% endif %}
    {% endblock %}
{% endblock %}
